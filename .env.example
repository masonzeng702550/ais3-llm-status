# Probe credentials for the AIS3 LLM API.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# In CI these are provided as GitHub Actions secrets, not from this file.

AIS3_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Discord or Slack incoming webhook for status-change alerts.
ALERT_WEBHOOK_URL=
